    ipv4 {
        table t_ospf;
        import all;
        export all;
    };
    area 0 {
        interface "dummy0" { stub; };
        interface "net12" { hello 1; dead count 2; };
        interface "net61" { hello 1; dead count 2; };
        interface "netext" { hello 1; dead count 2; };
        interface "sr1test" { hello 1; dead count 2; };

    };
